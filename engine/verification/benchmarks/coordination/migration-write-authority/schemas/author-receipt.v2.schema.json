{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridlewise.invalid/schemas/migration-write-authority-author-receipt/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "artifacts", "verifierTrustBase", "claims"],
  "properties": {
    "schemaVersion": { "const": "migration-write-authority-author-receipt/v2" },
    "status": { "const": "author-snapshot-unadmitted-externally-pinned-hash-required" },
    "artifacts": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "byteLength", "sha256"],
        "properties": {
          "relativePath": {
            "type": "string",
            "pattern": "^(?:scripts|src|verification|traceability)/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
          },
          "byteLength": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "verifierTrustBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "originClass",
        "lease",
        "environmentBindings",
        "node",
        "rootMetadata",
        "packageRootsDerivedInternally",
        "packages",
        "portability",
        "trustBaseIdentity"
      ],
      "properties": {
        "schemaVersion": { "const": "migration-write-authority-verifier-trust-base/v2" },
        "originClass": { "const": "portable-repository-qualification-trust-base" },
        "lease": { "$ref": "#/$defs/lease" },
        "environmentBindings": { "$ref": "#/$defs/environmentBindings" },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "originClass",
            "execArgv",
            "version",
            "byteLength",
            "sha256",
            "portableIdentity"
          ],
          "properties": {
            "originClass": { "const": "host-runtime-executable" },
            "execArgv": { "type": "array", "maxItems": 0 },
            "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "byteLength": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "portableIdentity": { "$ref": "#/$defs/sha256" }
          }
        },
        "rootMetadata": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/file" }
        },
        "packageRootsDerivedInternally": { "const": true },
        "packages": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/package" }
        },
        "portability": { "$ref": "#/$defs/portability" },
        "trustBaseIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coWeakeningPreventedByExternalReceiptHash", "serializedReceiptConfersAuthority", "independentAcceptance", "runtimeQualification"],
      "properties": {
        "coWeakeningPreventedByExternalReceiptHash": { "const": true },
        "serializedReceiptConfersAuthority": { "const": false },
        "independentAcceptance": { "const": false },
        "runtimeQualification": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "byteLength", "sha256"],
      "properties": {
        "relativePath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
        },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originClass",
        "name",
        "version",
        "packageJsonSha256",
        "declaredRuntimeDependencies",
        "files",
        "contentIdentity",
        "portableIdentity"
      ],
      "properties": {
        "originClass": { "const": "installed-package-closure-member" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "packageJsonSha256": { "$ref": "#/$defs/sha256" },
        "declaredRuntimeDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "contentIdentity": { "$ref": "#/$defs/sha256" },
        "portableIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseId", "leaseIdentity", "requiredUseCardinality"],
      "properties": {
        "leaseId": { "const": "migration-write-authority/verifier-trust-base" },
        "leaseIdentity": { "$ref": "#/$defs/sha256" },
        "requiredUseCardinality": { "const": 1 }
      }
    },
    "environmentBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "names"],
      "properties": {
        "mode": { "const": "compiled-source-accesses" },
        "names": { "type": "array", "maxItems": 0 }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "normalizedRootIdentity", "findingCount", "findings"],
      "properties": {
        "schemaVersion": { "const": "bridlewise-qualification-portable-disclosure/v1" },
        "normalizedRootIdentity": { "$ref": "#/$defs/sha256" },
        "findingCount": { "const": 0 },
        "findings": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
