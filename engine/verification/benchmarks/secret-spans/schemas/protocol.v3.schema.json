{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridlewise.invalid/schemas/secret-span-protocol/v3",
  "title": "Secret-span qualification protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authority",
    "scope",
    "repetitions",
    "runtimeProfile",
    "budgets",
    "minimumCoverage",
    "corpora",
    "candidateFamilies",
    "hardFloors",
    "publicSurfaces",
    "regexDenialCases",
    "blockedClaims"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bridlewise-secret-span-protocol/v3"
    },
    "status": {
      "const": "preregistered-candidate-neutral-synthetic-foundation"
    },
    "authority": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "encoding",
        "rawInputEgressAllowed",
        "repositoryAllowRulesMayWeakenFloor",
        "externalVerificationAllowed",
        "candidateExecutionTrust",
        "ambientEgressBoundary"
      ],
      "properties": {
        "profile": {
          "const": "bounded-snapshot-text-only"
        },
        "encoding": {
          "const": "strict-utf8-or-content-free-block"
        },
        "rawInputEgressAllowed": {
          "const": false
        },
        "repositoryAllowRulesMayWeakenFloor": {
          "const": false
        },
        "externalVerificationAllowed": {
          "const": false
        },
        "candidateExecutionTrust": {
          "const": "frozen-trusted-built-in-candidates-only"
        },
        "ambientEgressBoundary": {
          "const": "unqualified-worker-thread-is-not-a-security-boundary"
        }
      }
    },
    "repetitions": {
      "type": "integer",
      "const": 3
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mainExecArgv", "workerExecArgv", "workerStdout", "workerStderr"],
      "properties": {
        "mainExecArgv": { "type": "array", "maxItems": 0 },
        "workerExecArgv": { "type": "array", "maxItems": 0 },
        "workerStdout": { "const": "captured-bounded-scanned-never-forwarded" },
        "workerStderr": { "const": "captured-bounded-scanned-never-forwarded" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumProtocolBytes",
        "maximumCorpusBytes",
        "maximumFixturesPerCorpus",
        "maximumFixtureBytes",
        "maximumFragmentsPerFixture",
        "maximumFragmentTextBytes",
        "maximumExpectedSpansPerFixture",
        "maximumProposedSpansPerFixture",
        "maximumDetectionMilliseconds",
        "workerHeapMegabytes",
        "workerStackMegabytes",
        "cancelGraceMilliseconds",
        "maximumWorkerStdoutBytes",
        "maximumWorkerStderrBytes",
        "pageMaximumBytes"
      ],
      "properties": {
        "maximumProtocolBytes": { "const": 65536 },
        "maximumCorpusBytes": { "const": 131072 },
        "maximumFixturesPerCorpus": { "const": 64 },
        "maximumFixtureBytes": { "const": 65536 },
        "maximumFragmentsPerFixture": { "const": 64 },
        "maximumFragmentTextBytes": { "const": 16384 },
        "maximumExpectedSpansPerFixture": { "const": 64 },
        "maximumProposedSpansPerFixture": { "const": 128 },
        "maximumDetectionMilliseconds": { "const": 1000 },
        "workerHeapMegabytes": { "const": 64 },
        "workerStackMegabytes": { "const": 4 },
        "cancelGraceMilliseconds": { "const": 50 },
        "maximumWorkerStdoutBytes": { "const": 4096 },
        "maximumWorkerStderrBytes": { "const": 4096 },
        "pageMaximumBytes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": 17 },
            { "const": 31 },
            { "const": 64 }
          ],
          "items": false
        }
      }
    },
    "minimumCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpora",
        "fixtures",
        "positiveSecretFixturesPerCorpus",
        "safeNegativeFixtures",
        "invalidUtf8Fixtures",
        "parserFixtures",
        "safeNameTokens",
        "carrierClasses"
      ],
      "properties": {
        "corpora": { "const": 3 },
        "fixtures": { "const": 24 },
        "positiveSecretFixturesPerCorpus": { "const": 3 },
        "safeNegativeFixtures": { "const": 6 },
        "invalidUtf8Fixtures": { "const": 1 },
        "parserFixtures": { "const": 6 },
        "safeNameTokens": { "const": 20 },
        "carrierClasses": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            { "const": "adjacent" },
            { "const": "assignment" },
            { "const": "authorization-header" },
            { "const": "encoded" },
            { "const": "error-text" },
            { "const": "invalid-utf8" },
            { "const": "multiline" },
            { "const": "overlap" },
            { "const": "private-key-body" },
            { "const": "provider-prefix" },
            { "const": "safe-negative" },
            { "const": "split-generated" },
            { "const": "url" }
          ],
          "items": false
        }
      }
    },
    "corpora": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "path": {
            "type": "string",
            "pattern": "^verification/benchmarks/secret-spans/corpora/[a-z0-9.-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "candidateFamilies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mechanism", "productionEligibleFromThisProtocol"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "productionEligibleFromThisProtocol": {
            "const": false
          }
        }
      }
    },
    "hardFloors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactSpanPrecision",
        "exactSpanRecall",
        "falseRedactionCount",
        "publicSurfaceCanaryOccurrences",
        "pageBoundaryCanaryOccurrences",
        "safeFragmentPreservation",
        "safeByteSkeletonPreservation",
        "parserValidity",
        "safeNameMultisetPreservation",
        "redactionMultiplicity",
        "lineCountPreservation",
        "paginationReconstruction",
        "invalidUtf8Blocks",
        "candidateExceptions",
        "resourceBudgetViolations",
        "proposedSpanDenominatorPositive",
        "deterministicAcrossRepetitions"
      ],
      "properties": {
        "exactSpanPrecision": { "const": 1 },
        "exactSpanRecall": { "const": 1 },
        "falseRedactionCount": { "const": 0 },
        "publicSurfaceCanaryOccurrences": { "const": 0 },
        "pageBoundaryCanaryOccurrences": { "const": 0 },
        "safeFragmentPreservation": { "const": 1 },
        "safeByteSkeletonPreservation": { "const": 1 },
        "parserValidity": { "const": 1 },
        "safeNameMultisetPreservation": { "const": 1 },
        "redactionMultiplicity": { "const": 1 },
        "lineCountPreservation": { "const": 1 },
        "paginationReconstruction": { "const": 1 },
        "invalidUtf8Blocks": { "const": 1 },
        "candidateExceptions": { "const": 0 },
        "resourceBudgetViolations": { "const": 0 },
        "proposedSpanDenominatorPositive": { "const": true },
        "deterministicAcrossRepetitions": { "const": true }
      }
    },
    "publicSurfaces": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "sanitized-result",
          "page",
          "receipt",
          "progress",
          "log",
          "error",
          "cache-key",
          "index-document",
          "telemetry"
        ]
      }
    },
    "regexDenialCases": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "catastrophic-backtracking-shape",
          "empty-match-explosion",
          "huge-alternation-or-repetition",
          "unicode-or-encoding-expansion",
          "cancellation-race",
          "unsupported-backreference-or-lookaround"
        ]
      }
    },
    "blockedClaims": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
