{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridlewise.local/schemas/code-intelligence/run-record.v1.json",
  "title": "One code-intelligence benchmark repetition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "runnerIdentity", "protocolSha256", "policyBundleSha256", "candidateId", "candidateResolutionSha256", "candidateResolutionObject", "snapshot", "snapshotObject", "oracleSha256", "scenarioCatalogSha256", "scenarioId", "repetition", "startedAt", "endedAt", "process", "index", "toolCalls", "oracleResults", "failureInjections", "rawEvidence", "evidenceManifest", "qualificationEligible", "fatalInvariantResults"],
  "properties": {
    "schemaVersion": {"const": "code-intelligence-run-record/v2"}, "runId": {"type": "string", "minLength": 1}, "runnerIdentity": {"type": "string", "minLength": 1},
    "protocolSha256": {"$ref": "#/$defs/sha256Nonzero"}, "policyBundleSha256": {"$ref": "#/$defs/sha256Nonzero"}, "candidateId": {"type": "string"}, "candidateResolutionSha256": {"$ref": "#/$defs/sha256"},
    "candidateResolutionObject": {"$ref": "#/$defs/binding"},
    "snapshot": {"$ref": "https://bridlewise.local/schemas/code-intelligence/repository-snapshot.v2.json"}, "snapshotObject": {"$ref": "#/$defs/binding"},
    "oracleSha256": {"$ref": "#/$defs/sha256"}, "scenarioCatalogSha256": {"$ref": "#/$defs/sha256"},
    "scenarioId": {"enum": ["S01-clean-polyglot", "S02-monorepo-concurrency", "S03-adversarial-recovery"]}, "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "startedAt": {"type": "string", "format": "date-time"}, "endedAt": {"type": "string", "format": "date-time"},
    "process": {"type": "object", "required": ["startupNs", "exitCode", "terminationReason", "peakRssBytes", "cpuUserNs", "cpuSystemNs", "readBytes", "writeBytes"], "properties": {"startupNs": {"type": "integer", "minimum": 0}, "exitCode": {"type": ["integer", "null"]}, "terminationReason": {"type": "string"}, "peakRssBytes": {"type": "integer", "minimum": 0}, "cpuUserNs": {"type": "integer", "minimum": 0}, "cpuSystemNs": {"type": "integer", "minimum": 0}, "readBytes": {"type": "integer", "minimum": 0}, "writeBytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "index": {"type": "object", "required": ["startedAt", "durationNs", "filesClaimed", "bytesClaimed", "nodesClaimed", "edgesClaimed", "storageBytes", "generation", "inventorySha256"], "properties": {"startedAt": {"type": "string", "format": "date-time"}, "durationNs": {"type": "integer", "minimum": 0}, "filesClaimed": {"type": "integer", "minimum": 0}, "bytesClaimed": {"type": "integer", "minimum": 0}, "nodesClaimed": {"type": ["integer", "null"]}, "edgesClaimed": {"type": ["integer", "null"]}, "storageBytes": {"type": "integer", "minimum": 0}, "generation": {"type": "integer", "minimum": 1}, "inventorySha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "toolCalls": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sequence", "toolName", "toolSchemaSha256", "inputSha256", "outputSha256", "startedAt", "durationNs", "requestBytes", "responseBytes", "inputTokens", "outputTokens", "tokenCounterIdentity", "success", "errorClass"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "toolName": {"type": "string"}, "toolSchemaSha256": {"$ref": "#/$defs/sha256"}, "inputSha256": {"$ref": "#/$defs/sha256"}, "outputSha256": {"$ref": "#/$defs/sha256"}, "startedAt": {"type": "string", "format": "date-time"}, "durationNs": {"type": "integer", "minimum": 0}, "requestBytes": {"type": "integer", "minimum": 0}, "responseBytes": {"type": "integer", "minimum": 0}, "inputTokens": {"type": ["integer", "null"], "minimum": 0}, "outputTokens": {"type": ["integer", "null"], "minimum": 0}, "tokenCounterIdentity": {"type": "string"}, "success": {"type": "boolean"}, "errorClass": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "oracleResults": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "required": ["queryId", "class", "oracleSha256", "resultSha256", "verdict", "falsePositives", "falseNegatives"], "properties": {"queryId": {"type": "string"}, "class": {"type": "string"}, "oracleSha256": {"$ref": "#/$defs/sha256"}, "resultSha256": {"$ref": "#/$defs/sha256"}, "verdict": {"enum": ["pass", "fail", "blocked"]}, "falsePositives": {"type": "integer", "minimum": 0}, "falseNegatives": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
    "failureInjections": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": "object", "required": ["id", "expected", "observed", "verdict"], "properties": {"id": {"type": "string"}, "expected": {"type": "string"}, "observed": {"type": "string"}, "verdict": {"enum": ["pass", "fail", "blocked"]}}, "additionalProperties": false}},
    "fatalInvariantResults": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "required": ["id", "verdict", "evidenceSha256"], "properties": {"id": {"type": "string"}, "verdict": {"enum": ["pass", "fail", "blocked"]}, "evidenceSha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}},
    "rawEvidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "path", "sha256", "bytes", "mediaType", "raw", "sourceSha256"], "properties": {"kind": {"type": "string"}, "path": {"type": "string", "pattern": "^traceability/evidence/research/code-intelligence/sets/"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}, "mediaType": {"enum": ["application/json", "text/plain", "application/octet-stream"]}, "raw": {"type": "boolean"}, "sourceSha256": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "evidenceManifest": {"$ref": "#/$defs/manifestBinding"},
    "qualificationEligible": {"type": "boolean"}, "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sha256Nonzero": {"type": "string", "pattern": "^(?!0{64})[a-f0-9]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^traceability/evidence/research/code-intelligence/sets/"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "manifestBinding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^traceability/evidence/research/code-intelligence/sets/[a-z0-9-]+/manifest\\.json$"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
