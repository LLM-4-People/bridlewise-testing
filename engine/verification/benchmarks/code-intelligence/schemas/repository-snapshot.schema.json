{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridlewise.local/schemas/code-intelligence/repository-snapshot.v2.json",
  "title": "Authorized repository snapshot and eligible-file reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "snapshotClass", "trustedForQualification", "candidateResolutionSha256", "authorizationReceipt", "eligibleDiscoveryReceipt", "purpose", "capturedAt", "root", "git", "files", "indexInventory", "freshness"],
  "properties": {
    "schemaVersion": {"const": "code-intelligence-repository-snapshot/v2"},
    "snapshotId": {"type": "string", "minLength": 1}, "snapshotClass": {"enum": ["synthetic-untrusted", "authorized-real"]}, "trustedForQualification": {"type": "boolean"},
    "candidateResolutionSha256": {"$ref": "#/$defs/sha256"}, "authorizationReceipt": {"$ref": "#/$defs/bindingOrNull"}, "eligibleDiscoveryReceipt": {"$ref": "#/$defs/bindingOrNull"},
    "purpose": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "format": "date-time"},
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalPath", "descriptorSha256", "device", "inode", "repositoryIdentitySha256"],
      "properties": {"canonicalPath": {"type": "string", "pattern": "^/"}, "descriptorSha256": {"$ref": "#/$defs/sha256"}, "device": {"type": "integer"}, "inode": {"type": "integer"}, "repositoryIdentitySha256": {"$ref": "#/$defs/sha256"}}
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["headSha", "treeSha", "indexSha256", "worktreeSha256", "branch", "dirty", "staged", "untracked", "submodulesSha256", "lfsSha256"],
      "properties": {"headSha": {"$ref": "#/$defs/sha1"}, "treeSha": {"$ref": "#/$defs/sha1"}, "indexSha256": {"$ref": "#/$defs/sha256"}, "worktreeSha256": {"$ref": "#/$defs/sha256"}, "branch": {"type": "string"}, "dirty": {"type": "boolean"}, "staged": {"type": "boolean"}, "untracked": {"type": "boolean"}, "submodulesSha256": {"$ref": "#/$defs/sha256"}, "lfsSha256": {"$ref": "#/$defs/sha256"}}
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "kind", "disposition", "reason"],
        "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "kind": {"enum": ["regular", "symlink", "submodule", "lfs", "binary", "directory"]}, "disposition": {"enum": ["eligible", "ignored", "generated", "vendored", "binary", "symlink", "submodule", "lfs", "unreadable", "unsupported", "policy-excluded"]}, "reason": {"type": "string"}, "contentSha256": {"$ref": "#/$defs/sha256"}, "language": {"type": ["string", "null"]}}
      }
    },
    "indexInventory": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "contentSha256"], "properties": {"path": {"type": "string"}, "contentSha256": {"$ref": "#/$defs/sha256"}, "parser": {"type": "string"}}}
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["captureGeneration", "indexGeneration", "reconciled", "concurrentChangeDetected", "reconciledAt"],
      "properties": {"captureGeneration": {"type": "integer", "minimum": 1}, "indexGeneration": {"type": "integer", "minimum": 1}, "reconciled": {"type": "boolean"}, "concurrentChangeDetected": {"type": "boolean"}, "reconciledAt": {"type": "string", "format": "date-time"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"snapshotClass": {"const": "synthetic-untrusted"}}}, "then": {"properties": {"trustedForQualification": {"const": false}, "authorizationReceipt": {"type": "null"}, "eligibleDiscoveryReceipt": {"type": "null"}}}},
    {"if": {"properties": {"snapshotClass": {"const": "authorized-real"}}}, "then": {"properties": {"trustedForQualification": {"const": true}, "authorizationReceipt": {"$ref": "#/$defs/binding"}, "eligibleDiscoveryReceipt": {"$ref": "#/$defs/binding"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^traceability/evidence/research/code-intelligence/sets/"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "bindingOrNull": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding"}]}
  }
}
