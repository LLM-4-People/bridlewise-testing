{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridlewise.invalid/schemas/git-qualification-scenario-catalog-v1.json",
  "title": "Workspace/Git qualification scenario catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "requirements", "coverageClaims", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "bridlewise-git-qualification-catalog/v1" },
    "catalogId": { "const": "USR-043-DER-029-workspace-git" },
    "requirements": {
      "type": "array",
      "contains": { "const": "USR-043" },
      "allOf": [{ "contains": { "const": "DER-029" } }],
      "uniqueItems": true
    },
    "coverageClaims": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "requirements", "coverage", "execution", "fixture", "candidateAction", "repetitions", "oracle"],
      "properties": {
        "id": { "type": "string", "pattern": "^GIT-[A-Z]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 12 },
        "requirements": {
          "type": "array", "contains": { "const": "USR-043" },
          "allOf": [{ "contains": { "const": "DER-029" } }], "uniqueItems": true
        },
        "coverage": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["layer", "fixtureStatus", "networkMutation", "requiredCapabilities"],
          "properties": {
            "layer": { "enum": ["local", "fault-injected-local", "candidate-instrumented", "os-isolation", "hosted-disposable"] },
            "fixtureStatus": { "enum": ["executable", "capability-gated", "specification-gated"] },
            "networkMutation": { "const": false },
            "requiredCapabilities": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
            }
          }
        },
        "fixture": {
          "type": "object", "additionalProperties": false, "required": ["generator", "profile"],
          "properties": {
            "generator": { "enum": ["workspace", "repository-state", "remote-graph", "never-push", "fault", "self-evolution", "hosted-spec"] },
            "profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        },
        "candidateAction": {
          "type": "object", "additionalProperties": false, "required": ["kind", "effectClass", "approval"],
          "properties": {
            "kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "effectClass": { "enum": ["inspect-plan", "local-mutation", "remote-mutation", "self-update"] },
            "approval": { "enum": ["none", "bound-plan-required", "external-grant-required"] }
          }
        },
        "repetitions": {
          "type": "object", "additionalProperties": false, "required": ["minimum", "variants"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 3 },
            "variants": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
          }
        },
        "oracle": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "implementation", "objectGraphRequired", "status", "postconditions"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
            "implementation": { "const": "independent-git-filesystem-oracle/v1" },
            "objectGraphRequired": { "const": true },
            "status": { "enum": ["capture-executable", "evaluator-gated"] },
            "postconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 4 } }
          }
        }
      }
    }
  }
}
