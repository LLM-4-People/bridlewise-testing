  "behaviors": [
    {
      "id": "S3.1-B01",
      "name": "bounded unambiguous RFC 8785 canonical intake",
      "testName": "S3.1-B01 canonical intake rejects ambiguity, hostile structures, and every bound breach",
      "scenarios": [
        "S3.1-B01-DUPLICATE-ROOT-NESTED",
        "S3.1-B01-NEGATIVE-ZERO-RAW-PROGRAMMATIC",
        "S3.1-B01-UNICODE-NONFINITE",
        "S3.1-B01-SIZE-DEPTH-NODES",
        "S3.1-B01-SPARSE-CLASS-ACCESSOR-CYCLE",
        "S3.1-B01-SEQUENCE-2P53-SIGNED64-BOUNDARIES",
        "S3.1-B01-SCHEMA-UNKNOWN",
        "S3.1-B01-PROXY-TRAP-ZERO-RECURSIVE",
        "S3.1-B01-UTF8-BASE64-CROSS-FIELD",
        "S3.1-B01-TOOL-PAYLOAD-ALL-OR-NONE"
      ]
    },
    {
      "id": "S3.1-B02",
      "name": "exact-byte and structured raw normalization",
      "testName": "S3.1-B02 normalization preserves exact bytes, duplicate headers, causes, and rejects object smuggling",
      "scenarios": [
        "S3.1-B02-BINARY-COPY",
        "S3.1-B02-ORDERED-DUPLICATE-HEADERS",
        "S3.1-B02-ERROR-CAUSES",
        "S3.1-B02-STDERR-TOOL-PAYLOAD",
        "S3.1-B02-CLASS-UNKNOWN-CRLF",
        "S3.1-B02-PROXY-ACCESSOR-SUBCLASS-NO-READ"
      ]
    },
    {
      "id": "S3.1-B03",
      "name": "deterministic redacted projection and independent leakage oracle",
      "testName": "S3.1-B03 projection removes every raw surface and the independent oracle catches bypass variants",
      "scenarios": [
        "S3.1-B03-NESTED-RAW-CANARIES",
        "S3.1-B03-HEADER-TOOL-ERROR-CANARIES",
        "S3.1-B03-BASE64-URL-MIXED-CASE",
        "S3.1-B03-NONSTRING-CLASS-BYPASS",
        "S3.1-B03-BLIND-INDEX-INTERNAL-KEYED",
        "S3.1-B03-BLIND-INDEX-UNISSUED-CLONE",
        "S3.1-B03-PROXY-ORACLE-TRAP-ZERO"
      ]
    },
    {
      "id": "S3.1-B04",
      "name": "AES-256-GCM sealed payload and opaque operation ports",
      "testName": "S3.1-B04 AEAD authenticates ciphertext, tag, nonce, AAD, event binding, and issued ports",
      "scenarios": [
        "S3.1-B04-CIPHERTEXT-TAG-FLIP",
        "S3.1-B04-NONCE-AAD-SUBSTITUTION",
        "S3.1-B04-WRONG-SECRET",
        "S3.1-B04-NONCE-LENGTH-FORGED-PORT",
        "S3.1-B04-CIPHERTEXT-REHASHED-AUTH",
        "S3.1-B04-AAD-REHASHED-AUTH",
        "S3.1-B04-PROXY-ACCESSOR-SUBCLASS-TRAP-ZERO"
      ]
    },
    {
      "id": "S3.1-B05",
      "name": "domain-separated hash and HMAC ledger verification",
      "testName": "S3.1-B05 hash and HMAC verification identifies mutation, gaps, reorder, recomputation, and transplant",
      "scenarios": [
        "S3.1-B05-ENVELOPE-MUTATION",
        "S3.1-B05-GAP-REORDER",
        "S3.1-B05-UNKEYED-RECOMPUTATION",
        "S3.1-B05-WRONG-HMAC",
        "S3.1-B05-LEDGER-SEGMENT-TRANSPLANT",
        "S3.1-B05-MAC-LENGTH-FRAME-SPLIT",
        "S3.1-B05-MAC-INDEPENDENT-VECTOR",
        "S3.1-B05-CAPABILITY-CROSS-PURPOSE",
        "S3.1-B05-ANCHOR-EMPTY-CONTINUATION",
        "S3.1-B05-MALFORMED-TOCTOU-TYPED-INVALID"
      ]
    },
    {
      "id": "S3.1-B06",
      "name": "pure persist-before-forward outbox and receipt state",
      "testName": "S3.1-B06 outbox contracts enforce persist-before-forward, binding, idempotency, and no authority",
      "scenarios": [
        "S3.1-B06-FORWARD-BEFORE-COMMIT",
        "S3.1-B06-COMMIT-EVIDENCE-CONFLICT",
        "S3.1-B06-RECEIPT-BEFORE-FORWARD",
        "S3.1-B06-RECEIPT-BINDING-CONFLICT",
        "S3.1-B06-IDEMPOTENT-RETRY-CORRELATION-CONFLICT",
        "S3.1-B06-PROXY-ACCESSOR-TRAP-ZERO"
      ]
    },
    {
      "id": "S3.1-B07",
      "name": "offline bundle identity and deny-by-default authority",
      "testName": "S3.1-B07 schemas, bundle, root policy, and receipts expose no secret-key or runtime authority",
      "scenarios": [
        "S3.1-B07-SCHEMA-DIALECT-FREEZE",
        "S3.1-B07-NO-KEY-PROPERTIES",
        "S3.1-B07-CAPABILITIES-DISABLED",
        "S3.1-B07-EFFECTS-UNAVAILABLE",
        "S3.1-B07-VERIFIER-PROXY-TRAP-ZERO",
        "S3.1-B07-SAFE-STRUCTURAL-IDENTITY"
      ]
    }
  ],
  "acceptance": {
    "minimumIndependentCausalScenariosPerBehavior": 3,
    "syntheticCanariesOnly": true,
    "constantTimeMacAndDigestComparison": true,
    "rawKeysInSchemasProjectionsReceipts": "forbidden",
