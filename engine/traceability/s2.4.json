  "behaviors": [
    {
      "id": "S2.4-B01",
      "name": "exact registry, source, row-set, and generated-schema binding",
      "testName": "S2.4-B01 registry bytes, source lineage, row hashes, and schema artifact are bound",
      "scenarios": [
        "S2.4-B01-CONTROL",
        "S2.4-B01-SOURCE-HASH-DRIFT",
        "S2.4-B01-ROW-HASH-DRIFT",
        "S2.4-B01-HARD-COUNT-DRIFT",
        "S2.4-B01-CROSS-EPOCH-PROVENANCE",
        "S2.4-B01-DUPLICATE-JSON-KEY"
      ]
    },
    {
      "id": "S2.4-B02",
      "name": "strict identifier and reference closure",
      "testName": "S2.4-B02 malformed, duplicate, unknown, and orphan references fail closed",
      "scenarios": [
        "S2.4-B02-MALFORMED-ID",
        "S2.4-B02-DUPLICATE-ID",
        "S2.4-B02-UNKNOWN-REFERENCE",
        "S2.4-B02-ORPHAN-NON-UNASSESSED"
      ]
    },
    {
      "id": "S2.4-B03",
      "name": "false-satisfaction and secret-value rejection with future-unassessed allowance",
      "testName": "S2.4-B03 false satisfied claims and secret-like values fail while unassessed future requirements remain explicit",
      "scenarios": [
        "S2.4-B03-FALSE-SATISFIED-REQUIREMENT",
        "S2.4-B03-FALSE-SATISFIED-CONTROL",
        "S2.4-B03-SECRET-LIKE-VALUE",
        "S2.4-B03-UNASSESSED-FUTURE-CONTROL"
      ]
    },
    {
      "id": "S2.4-B04",
      "name": "root, offline, preflight, and slice trace registry binding",
      "testName": "S2.4-B04 root policy, offline identity, preflight receipt, and slice traces bind the registry without enabling effects",
      "scenarios": [
        "S2.4-B04-ROOT-REGISTRY-HASH-TAMPER",
        "S2.4-B04-OFFLINE-IDENTITY-TAMPER",
        "S2.4-B04-PREFLIGHT-RECEIPT-TAMPER",
        "S2.4-B04-CAPABILITY-NON-REGRESSION"
      ]
    },
    {
      "id": "S2.4-B05",
      "name": "dual builder/runtime surface evidence isolation and honest availability",
      "testName": "S2.4-B05 dual builder/runtime assessments fail closed without cross-surface evidence",
      "scenarios": [
        "S2.4-B05-CONTROL",
        "S2.4-B05-ONE-SIDED",
        "S2.4-B05-HOSTILE-EVIDENCE"
      ]
    }
  ],
  "acceptance": {
    "minimumDistinctScenariosPerBehavior": 3,
    "futureRequirementPolicy": "explicitly-unassessed-may-remain-unlinked-to-implementation",
    "satisfiedClaimPolicy": "implemented-requirements-require-authority-implementation-test-and-evidence-links",
    "secretPolicy": "literal-secret-like-values-forbidden",
    "modelMayNotScoreItself": true,
    "candidateMustBeFrozenBeforeFinalHashAudit": true
  },
