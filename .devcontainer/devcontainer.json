{
  "name": "Bridlewise (developer preview)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils@sha256:e76a6a8a35d1ad824daad1540725e0ec9f8ed2dc00d2850e990a9830013c7d08": {
      "installZsh": false
    }
  },
  "postCreateCommand": "npm ci && npm --prefix engine ci && npm run bootstrap:hooks && chmod 600 engine/bridlewise.config.json",
  "forwardPorts": [5173, 5174],
  "portsAttributes": {
    "5173": { "label": "Cockpit", "onAutoForward": "openPreview" },
    "5174": { "label": "Loopback API", "onAutoForward": "silent" }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteUser": "node"
}
